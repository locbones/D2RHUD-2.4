#include "resource.h"
#include "Version.h"
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION D2RHUD_VERSION_RESOURCE
 PRODUCTVERSION D2RHUD_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "D2RHUD"
            VALUE "FileVersion", D2RHUD_VERSION
            VALUE "InternalName", "d2rhud"
            VALUE "OriginalFilename", "d2rhud.dll"
            VALUE "ProductName", "D2RHUD"
            VALUE "ProductVersion", D2RHUD_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

